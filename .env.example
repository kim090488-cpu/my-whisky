# Supabase ─────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
#
# ⚠️ 이 파일은 git에 커밋됩니다 — 진짜 키는 절대 여기 넣지 마세요.
# 진짜 키는 `.env.local` 에만 (gitignore 됨).
#
# URL은 베이스만 — /rest/v1/ 등 path는 SDK가 자동 추가.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR-ANON-KEY

# Service role — 시드 스크립트·관리자 작업 전용. 절대 클라이언트에 노출 X
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR-SERVICE-ROLE-KEY
